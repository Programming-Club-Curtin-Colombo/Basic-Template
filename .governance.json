{
  "audit": {
    "sinks": {
      "discord": true,
      "repo": true,
      "webhook": false
    }
  },
  "emailValidation": {
    "enabled": true,
    "allowedEmailDomains": [
      "student.curtin.edu.au"
    ]
  },
  "roles": {
    "maintainers": [],
    "external": {
      "whitelistUsers": [],
      "requireApproval": true,
      "requireDomainCheck": true
    }
  },
  "debug": {
    "dryRun": false
  },
  "standards": {
    "enforceAPI": false
  },
  "requiredStages": {
    "lint": true,
    "test": true,
    "security": true,
    "build": "conditional"
  }
}